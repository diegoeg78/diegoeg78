generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Listing {
  id              Int      @id @default(autoincrement())
  userId          String
  address         String
  city            String   @default("")
  state           String   @default("")
  price           Float
  bedrooms        Int      @default(0)
  bathrooms       Float    @default(0)
  sqft            Int      @default(0)
  yearBuilt       Int      @default(0)
  agentNotes      String   @default("")
  mlsDescription  String   @default("")
  cmaData         String   @default("[]")
  cmaSummary      String   @default("")
  videoScript     String   @default("")
  fairHousingScan String   @default("")
  sellerNotes     String   @default("")
  coverPhotoB64   String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

model BrandingProfile {
  id              String   @id          // Clerk userId
  agentName       String
  phone           String
  email           String
  website         String   @default("")
  overlayPosition String   @default("bottom-right")
  bgColor         String   @default("#000000")
  textColor       String   @default("#ffffff")
  opacity         Float    @default(0.6)
  fontSize        Int      @default(22)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
